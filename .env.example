# =============================================================================
# FamilyTruck API — plantilla de variables de entorno
# Copia este archivo como `.env` (desarrollo) o registra estas variables en
# Vercel > Project Settings > Environment Variables (producción).
# TODOS los valores son ficticios: reemplázalos por los tuyos y nunca subas `.env`.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
PORT=3000
# Zona horaria IANA con la que se calculan los vencimientos
APP_TIMEZONE=America/Bogota

# --- CORS ---------------------------------------------------------------------
# Dominios del frontend autorizados a llamar a la API, separados por coma.
# Sin definir: http://localhost:5173, http://localhost:3000 y http://localhost:3001 (desarrollo)
CORS_ORIGINS=https://tu-frontend.vercel.app,http://localhost:5173

# --- Autenticación ----------------------------------------------------------
# Cadena larga y aleatoria, distinta por entorno (genera una con: openssl rand -hex 32)
JWT_SECRET=reemplaza-por-un-secreto-aleatorio-de-64-caracteres

# --- Asesor financiero IA (POST /advisor/finance) ---------------------------
# Clave de https://console.anthropic.com. Sin ella el endpoint responde 503 (el resto de la API funciona).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: modelo de Claude (por defecto claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# --- Base de datos: Supabase (producción / Vercel) --------------------------
# Supabase > Project Settings > Database > Connection string > Transaction pooler (puerto 6543)
# Si la contraseña tiene caracteres especiales (@ : / # ?), codifícalos en URL (@ -> %40).
DATABASE_URL=postgresql://postgres.tu-project-ref:tu-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Supabase exige SSL
DB_SSL=true
# Opcional: CA de Supabase (Project Settings > Database > SSL) en una línea, con \n como salto
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIF...\n-----END CERTIFICATE-----
# Conexiones por instancia de la función serverless (mantenlo bajo en Vercel)
DB_POOL_MAX=2
# NUNCA true en producción: sincronizar el esquema puede borrar columnas y datos
DB_SYNCHRONIZE=false

# --- Base de datos: Docker local (alternativa para desarrollo) --------------
# Comenta DATABASE_URL y DB_SSL arriba y descomenta este bloque.
# docker-compose.yml también lee estas variables.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=tu-password-local
# DB_NAME=familytruck_db
# DB_SYNCHRONIZE=true
