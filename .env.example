# Servidor
PORT=3000
# Zona horaria del negocio para calcular vencimientos (IANA)
APP_TIMEZONE=America/Bogota

# Base de datos PostgreSQL (también la usa docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=familytruck_db

# JWT: usa una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambia_este_secreto
